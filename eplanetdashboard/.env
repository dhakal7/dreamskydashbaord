# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the dream-sky backend. Change to production URL when deploying.
VITE_API_BASE_URL=http://localhost:5001/api

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use mock data (demo dashboards work without the backend).
# Set to "false" to switch to live dream-sky API with real JWT auth.
VITE_USE_MOCK=false

# ── Cross-app URLs ────────────────────────────────────────────────────────────
# Landing page URL — users are redirected here after logout.
VITE_LANDING_URL=http://localhost:5174
