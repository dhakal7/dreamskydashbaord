# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dreamsky_db?schema=public"

# ─── JWT Secrets ──────────────────────────────────────────
# Must be long, random strings. Different for access vs refresh.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Document Encryption ─────────────────────────────────
# Must be exactly 64 hex characters (32 bytes for AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY=generate-a-64-char-hex-key-using-the-command-above

# ─── Email / SMTP (Nodemailer) ───────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587. Use a 16-char Gmail App Password.
# For a custom host use smtp.yourdomain.com and 587 (STARTTLS) or 465 (SSL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password-or-smtp-password
EMAIL_FROM=DreamSky Education Consultancy <youraddress@gmail.com>
