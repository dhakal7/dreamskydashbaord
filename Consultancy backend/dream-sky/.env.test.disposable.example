# ─── DreamSky CRM: Disposable Integration Test Configuration (Example) ────
# This configuration is strictly for running automated integration tests
# against an isolated, disposable PostgreSQL cluster on port 5433.
#
# DO NOT POINT TO PORT 5432 OR TO ANY PRODUCTION DATABASE.

NODE_ENV=test
PORT=5002

# Target must be strictly Unix domain socket $HOME/.dreamsky_sock_5433, port 5433, database dreamsky_test_disposable
DATABASE_URL=postgresql://dreamsky_test_user:replace_with_test_password@%2FUsers%2Fsuyogdhakal%2F.dreamsky_sock_5433:5433/dreamsky_test_disposable?schema=public

# Mandatory Authorization Flags for Disposable Testing
ALLOW_INTEGRATION_TEST_DB=true
ALLOW_DESTRUCTIVE_OPERATIONS=true

# Test Cluster Reference (Local macOS Homebrew cluster)
DISPOSABLE_CLUSTER_PORT=5433
DISPOSABLE_CLUSTER_DIR=/tmp/dreamsky_disposable_cluster_5433

# JWT Secrets for Test Session (Random Mock Strings)
JWT_ACCESS_SECRET=mock-test-jwt-access-secret-for-disposable-integration-tests-only
JWT_REFRESH_SECRET=mock-test-jwt-refresh-secret-for-disposable-integration-tests-only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# Test Encryption Key (64 hex characters)
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Isolated Disposable Upload Directory (Must match /tmp/dreamsky_test_uploads_5433)
UPLOAD_DIR=/tmp/dreamsky_test_uploads_5433
